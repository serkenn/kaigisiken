# ローカル開発用シークレット（`wrangler pages dev` が読み込む）
# このファイルを `.dev.vars` にコピーして値を埋める（.dev.vars はコミットしない）。

SESSION_SECRET="任意の長いランダム文字列に変更してください"

# AI（codex-everywhere / Responses API / gpt-5.5）
# プロバイダ等の非シークレット設定は wrangler.toml の [vars] にある。
# ここにはシークレット（APIキー）だけ置く:
OPENAI_API_KEY="codex-everywhere で発行したAPIキー"

# 別プロバイダに切替える場合の例:
#   通常のOpenAI:   AI_PROVIDER=openai      / OPENAI_BASE_URL=https://api.openai.com/v1 / AI_MODEL=gpt-4o-mini
#   Anthropic:      AI_PROVIDER=anthropic   / ANTHROPIC_API_KEY=sk-ant-... / AI_MODEL=claude-haiku-4-5
