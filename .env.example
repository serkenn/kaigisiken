# Docker(compose) 用の環境変数。コピーして .env を作る（.env はコミットしない）。

# ---- Cloudflare Tunnel ----
# Zero Trust → Networks → Tunnels で作成したトンネルのトークン
TUNNEL_TOKEN=eyJ...

# ---- Cloudflare Access（前段認証）----
# Zero Trust のチーム名ドメイン（必須。例: yourteam.cloudflareaccess.com）
ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# Access アプリの Application Audience (AUD) タグ（任意。空ならチーム検証のみ＝少し緩い）
ACCESS_AUD=

# ---- AI（codex-everywhere / Responses API / gpt-5.5）----
OPENAI_API_KEY=codex-everywhere で発行したAPIキー
# OPENAI_BASE_URL=https://codex-everywhere.com
# AI_MODEL=gpt-5.5
# AI_REASONING_EFFORT=medium

# ---- benkyo（ロードマップ）----
# ホストの benkyo データディレクトリ（`benkyo info` の db_path の親）
# Debian の既定: /home/<user>/.local/share/benkyo
BENKYO_DIR=/home/youruser/.local/share/benkyo
BENKYO_PROJECT=prj21
